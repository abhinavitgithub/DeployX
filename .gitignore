# DeployX - .gitignore

# Environment & Secret files (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
id_rsa*
id_ed25519*
secrets.yaml
secrets.json
kubeconfig*
credentials
credentials.json
token.json

# Python & FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/

# Testing & Quality Assurance
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.mutmut-cache/
.hypothesis/
.ruff_cache/
.mypy_cache/

# Node.js & Frontend (Dashboard)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.next/
out/

# Containers & Kubernetes
docker-compose.override.yml
*.local.yaml
*.local.yml
helm/charts/*.tgz

# Terraform & AWS Infrastructure
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Operating System & IDEs
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs & Temporary Files
logs/
*.log
tmp/
temp/
scratch/
backups/
backups/

# Terraform plan files (may contain sensitive values)
*.tfplan
*.tfplan.*
*.plan
