# DeployX - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT-SPECIFIC VALUES.
# NEVER COMMIT .env TO VERSION CONTROL.

# ==========================================
# Application Configuration
# ==========================================
APP_NAME=deployx-backend
APP_VERSION=1.0.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==========================================
# Security & Networking
# ==========================================
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# ==========================================
# Blue-Green Deployment & Disaster Recovery
# ==========================================
ACTIVE_DEPLOYMENT_COLOR=blue
STANDBY_DEPLOYMENT_COLOR=green
BLUE_ENDPOINT=http://deployx-backend-blue:8000
GREEN_ENDPOINT=http://deployx-backend-green:8000
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT_SECONDS=5
HEALTH_CHECK_INTERVAL_SECONDS=2
HEALTH_CHECK_MAX_RETRIES=3
DR_AUTO_ROLLBACK_ENABLED=true
DR_FAILURE_THRESHOLD=3

# ==========================================
# Kubernetes Integration
# ==========================================
KUBERNETES_IN_CLUSTER=false
KUBERNETES_NAMESPACE=deployx
KUBECONFIG_PATH=~/.kube/config

# ==========================================
# Observability & Metrics
# ==========================================
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics
PROMETHEUS_SCRAPE_PORT=8000

# ==========================================
# Diagnostics & LLM Engine (Local / Pluggable)
# ==========================================
DIAGNOSTICS_MODE=rule_based
# Set to true only if local Ollama daemon is running
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ==========================================
# AWS Infrastructure (Staging / Production Mock)
# ==========================================
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BACKUP_BUCKET=deployx-state-backup-dev
AWS_CLOUDWATCH_NAMESPACE=DeployX/Platform
